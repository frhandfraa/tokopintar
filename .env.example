# File: .env.example
# Salin file ini menjadi .env lalu isi dengan nilai yang sesuai

# --- KONFIGURASI DATABASE (POSTGRES) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=password_rahasia_anda
POSTGRES_DB=tokopintar_db
DATABASE_URL=postgresql://admin:password_rahasia_anda@db:5432/tokopintar_db

# --- KONFIGURASI REDIS (CACHE) ---
REDIS_URL=redis://redis:6379/0

# --- KONFIGURASI KEAMANAN (JWT) ---
JWT_SECRET_KEY=buat_string_random_panjang_disini
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- KONFIGURASI ANTAR SERVICE ---
# URL untuk App Server memanggil AI Service
AI_SERVICE_URL=http://ai_service:5001